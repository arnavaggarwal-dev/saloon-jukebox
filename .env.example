# ---------------------------------------------------------------------------
# Saloon Jukebox — environment
#
# Copy to `.env.local` and fill in your own project's values:
#     cp .env.example .env.local
#
# Both variables are OPTIONAL. With them unset the app still runs and plays
# music, using a local fallback backend that syncs the queue between tabs in
# one browser. Set them to share the queue across devices.
# ---------------------------------------------------------------------------

# Supabase Project URL — Dashboard > Project Settings > API
VITE_SUPABASE_URL=

# Supabase anon / public key (newer projects call it "publishable").
#
# This key is MEANT to be public: it ships inside the browser bundle. It is
# safe here because Row Level Security makes the tables read-only to it and
# every write goes through a SECURITY DEFINER function (see
# supabase/migrations/001_initial_schema.sql).
#
# NEVER put the `service_role` key in this file or anywhere else in the client.
VITE_SUPABASE_ANON_KEY=
