# Dependencies
node_modules/

# Build output. dist/index.html is deliberately committed: it IS the
# standalone app, so you can download that one file and open it.
dist/*
!dist/index.html
dist-ssr/
*.local

# Environment — never commit real credentials.
# `.env.example` documents the shape; your own values stay on your machine.
.env
.env.*
!.env.example

# Test artefacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
